{
    "name": "vancil/flint-auth",
    "description": "UI scaffold for Flint — session-based auth with Bootstrap, Vue, and React presets",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {"type": "vcs", "url": "https://github.com/Vancil/flint"}
    ],
    "require": {
        "php": ">=8.1",
        "vancil/flint": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Vancil\\FlintAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true
    }
}
